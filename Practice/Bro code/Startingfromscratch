#include <stdio.h>

int main()
{
    char name[50][50];
    int age[50], studnum, i=0;
    float grade[50];

    printf("Enter number of student: ");
    scanf("%d", &studnum);

    while(i < studnum)
    {
        printf("Enter name of student: ");
        scanf(" %s", name[i]);
        printf("Enter age of student: ");
        scanf("%d", &age[i]);
        printf("Enter grade of student: ");
        scanf("%f", &grade[i]);
        i++;
    }

    printf("\nStudent Information:\n");
    printf("--------------------------------------\n");
    printf("Name             Age    Grade\n");
    printf("--------------------------------------\n");

    for(i = 0; i < studnum; i++)
    {
        printf("%s             %d    %.2f\n", name[i], age[i], grade[i]);
    }

    return 0;
}